# Copy this file to /srv/zenon-pillar-tracker-dev/.env on the development host.
# Keep real secrets out of the repository.
IMAGE=ghcr.io/michznn/zenon-pillar-tracker:development
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
DATA_DIR=/srv/zenon-pillar-tracker-dev/data_store
COMPOSE_PROFILES=

# Optional. Leave empty until a development bot is configured.
TELEGRAM_BOT_API_KEY=
