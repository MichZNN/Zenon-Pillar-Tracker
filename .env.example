# Copy this file to .env. Keep real secrets out of the repository.
# These values are used by compose.yaml for a Linux deployment.
IMAGE=ghcr.io/michznn/zenon-pillar-tracker:main
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
DATA_DIR=./data_store
COMPOSE_PROFILES=collector

# Optional: replace with the token from BotFather or leave empty.
TELEGRAM_BOT_API_KEY=
